NEXT_PUBLIC_APP_NAME=ExamVault AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and publishable/anon key. Both the NEXT_PUBLIC_* names and the
# SUPABASE_* names are supported to match different deployment setups.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy alias supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Non-public names are also accepted for server-side / local installation flows.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Secret keys are server-only and must never be exposed to the browser.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Configure a hard-to-guess path (must start with /) for the private admin portal.
ADMIN_PORTAL_PATH=/secure-examvault-admin-x8f4h2

# Optional integrations used in later phases.
OPENAI_API_KEY=
GOOGLE_ANALYTICS_ID=
POSTHOG_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

NEXT_PUBLIC_APP_NAME=ExamVault AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and publishable/anon key are public client credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy anon key is also supported if your project still uses it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server only. Never prefix this value with NEXT_PUBLIC_ or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Configure a hard-to-guess path (must start with /) for the private admin portal.
ADMIN_PORTAL_PATH=/secure-examvault-admin-x8f4h2

# Optional integrations used in later phases.
OPENAI_API_KEY=
GOOGLE_ANALYTICS_ID=
POSTHOG_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
